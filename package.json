{
  "name": "anagatasentinel",
  "version": "0.1.0",
  "description": "Security monitoring desktop application — Wails v2 + Go backend + Svelte 5 frontend",
  "author": "Eve Lin <207277820+evelinix@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evelinix/AnagataSentinel.git"
  },
  "homepage": "https://github.com/evelinix/AnagataSentinel#readme",
  "bugs": {
    "url": "https://github.com/evelinix/AnagataSentinel/issues"
  },
  "keywords": [
    "wails",
    "svelte",
    "security",
    "monitoring",
    "desktop"
  ],
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "cd frontend && pnpm lint",
    "lint:fix": "cd frontend && pnpm lint:fix",
    "format": "cd frontend && pnpm format",
    "format:check": "cd frontend && pnpm format:check",
    "check": "cd frontend && npx svelte-check"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,svelte}": [
      "pnpm --dir frontend exec eslint --fix",
      "pnpm --dir frontend exec prettier --write"
    ],
    "frontend/src/**/*.css": [
      "pnpm --dir frontend exec prettier --write"
    ],
    "**/*.go": [
      "gofmt -s -w"
    ]
  }
}
